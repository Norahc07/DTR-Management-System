# Copy to .env.local and fill in values from Supabase > Project Settings > API.
# Only the PUBLIC (anon / publishable) key belongs here. NEVER put the
# service-role key in any VITE_ variable: Vite embeds these in browser code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: absolute URL used in password-reset emails (defaults to window.location.origin)
VITE_SITE_URL=http://localhost:5175
